# Copy to .env on the server and fill in (README, "Deploy"). Never on a dev machine: .env switches every
# `docker compose` command in this directory to the production setup.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# openssl rand -hex 24 for each of the three
DB_PASSWORD=
DB_ROOT_PASSWORD=
FORWARDING_SECRET=

# Only for on-demand game servers (README, "Server discovery and groups"): the proxy's key to the waker, also
# openssl rand -hex 24. Empty keeps the waker from starting.
WAKER_TOKEN=

# The proxy serves the resource pack on 127.0.0.1:RESOURCE_PACK_PORT; the web server in front of it publishes it
# at RESOURCE_PACK_URL.
RESOURCE_PACK_PORT=8080
RESOURCE_PACK_URL=https://BlockcraftMC.net/blockcraft.zip

# What messages show as <ip>, <website>, <shop>, <teamspeak> and <discord>; empty keeps the plugins' config.yml.
NETWORK_IP=BlockcraftMC.net
NETWORK_WEBSITE=
NETWORK_SHOP=
NETWORK_TEAMSPEAK=
NETWORK_DISCORD=
