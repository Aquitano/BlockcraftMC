{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/kill_effects",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/kill_effects"
        }
      },
      {
        "when": "blockcraft:icon/quicksg",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/quicksg"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/iron_sword"
    }
  }
}
