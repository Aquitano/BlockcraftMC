{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/premium_area",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/premium_area"
        }
      },
      {
        "when": "blockcraft:icon/win_effects",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/win_effects"
        }
      },
      {
        "when": "blockcraft:sternenfront/jetpack",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/sternenfront/jetpack"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/firework_rocket"
    }
  }
}
