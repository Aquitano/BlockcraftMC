{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/recap",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/recap"
        }
      },
      {
        "when": "blockcraft:icon/tool_add_friend",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/tool_add_friend"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/writable_book"
    }
  }
}
