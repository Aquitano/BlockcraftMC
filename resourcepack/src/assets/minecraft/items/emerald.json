{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/emeraldrush",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/emeraldrush"
        }
      },
      {
        "when": "blockcraft:icon/ttt_shop",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/ttt_shop"
        }
      },
      {
        "when": "blockcraft:props/emerald",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/props/emerald"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/emerald"
    }
  }
}
