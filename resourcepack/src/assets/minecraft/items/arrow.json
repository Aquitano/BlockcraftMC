{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/back",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/back"
        }
      },
      {
        "when": "blockcraft:icon/previous",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/previous"
        }
      },
      {
        "when": "blockcraft:icon/spectate_previous",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/spectate_previous"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/arrow"
    }
  }
}
