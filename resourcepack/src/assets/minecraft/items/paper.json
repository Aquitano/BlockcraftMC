{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/page",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/page"
        }
      },
      {
        "when": "blockcraft:icon/tool_requests",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/tool_requests"
        }
      },
      {
        "when": "blockcraft:icon/vote",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/vote"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/paper"
    }
  }
}
