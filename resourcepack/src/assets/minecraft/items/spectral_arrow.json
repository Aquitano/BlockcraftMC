{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/next",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/next"
        }
      },
      {
        "when": "blockcraft:icon/spectate_next",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/spectate_next"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/spectral_arrow"
    }
  }
}
