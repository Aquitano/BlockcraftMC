{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/achievements",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/achievements"
        }
      },
      {
        "when": "blockcraft:icon/lobbies",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/lobbies"
        }
      },
      {
        "when": "blockcraft:props/star",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/props/star"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/nether_star"
    }
  }
}
