{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "blockcraft:icon/staff_spectate",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/staff_spectate"
        }
      },
      {
        "when": "blockcraft:icon/tool_home",
        "model": {
          "type": "minecraft:model",
          "model": "blockcraft:item/tool_home"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/ender_eye"
    }
  }
}
